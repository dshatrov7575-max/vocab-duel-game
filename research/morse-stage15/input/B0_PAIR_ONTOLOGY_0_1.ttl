ex:projectionKind a rdf:Property .
ex:candidate a rdf:Property .
ex:specialState a rdf:Property .
ex:allowedCandidate a rdf:Property .
ex:profileId a rdf:Property .
ex:profileVersion a rdf:Property .
ex:requiredMappingVersion a rdf:Property .
ex:supportsDistinction a rdf:Property .
ex:allowedTransition a rdf:Property .
ex:fromState a rdf:Property .
ex:toState a rdf:Property .
ex:changeRecordPresent a rdf:Property .
